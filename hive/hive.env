# Settings for the self-hosted Hive stack in hive/docker-compose.yml.
#
# These secrets are for a local demo only. They are committed so that
# "docker compose up" works from a clean checkout with no setup steps.
# Never reuse them for a real Hive installation.

DOCKER_REGISTRY=ghcr.io/graphql-hive/
DOCKER_TAG=:12.1.0

HIVE_APP_BASE_URL=http://localhost:8080

POSTGRES_DB=registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=2cf4b627702a6a7fe5494a515c1a1e4c6a350dfdc5a06f61ec1f72e8f145912b

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=c9e67f0e4ba988429849e866251d383a6f65a05fca139c6977797edc43e78d98

REDIS_PASSWORD=1381d4b5196ce51127bb23366d033c4fd95df93b696a224885a8584a8bbc6c38

